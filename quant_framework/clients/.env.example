# Environment variables for OKX API
# Copy this file to .env and fill in your actual credentials

# OKX Testnet Configuration
OKX_TESTNET=true

# OKX Testnet API Credentials
OKX_API_KEY_TEST=your_okx_testnet_api_key
OKX_SECRET_KEY_TEST=your_okx_testnet_secret_key

# OKX Production API Credentials
OKX_API_KEY=your_okx_production_api_key
OKX_SECRET_KEY=your_okx_production_secret_key
OKX_PASSPHRASE=your_okx_passphrase

# Proxy Configuration (optional)
HTTP_PROXY=
HTTPS_PROXY=